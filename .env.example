# Order-Flow production environment template
# Copy to .env on the deployment host. Never commit real values.

# Django
DJANGO_SETTINGS_MODULE=dineflow.settings.prod
APP_NAME=Order-Flow
APP_SHORT_NAME=OF
APP_TAGLINE=Restaurant order operations
SECRET_KEY=replace-with-a-strong-unique-random-secret-at-least-50-chars
# REQUIRED in production — must differ from SECRET_KEY.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Existing payment data encrypted with SECRET_KEY remains readable (crypto.py falls back).
PAYMENT_ENCRYPTION_KEY=replace-with-a-separate-strong-payment-encryption-key
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_HSTS_PRELOAD=False

# Database
# Use a managed PostgreSQL URL, Supabase pooler URL, or the local Compose db URL.
# Supabase pooler example:
# DATABASE_URL=postgresql://postgres.[project]:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://orderflow_user:replace-with-db-password@db:5432/orderflow
DB_SSLMODE=require

# Local Compose PostgreSQL service
DB_NAME=orderflow
DB_USER=orderflow_user
DB_PASSWORD=replace-with-db-password

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0

# Async payment processing
PAYMENT_JOBS_INLINE=False

# Security headers — CSP is enforcing by default in production.
# Set to True only as a temporary rollback during CSP policy tuning.
CONTENT_SECURITY_POLICY_REPORT_ONLY=False
PERMISSIONS_POLICY=camera=(),microphone=(),geolocation=(),usb=()

# Razorpay — Single Platform Account
# ALL restaurants use these credentials by default.
# Individual restaurants can optionally override via Owner Dashboard.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_ENV=sandbox

# Supabase S3 Storage (Required for Media files in production)
# Get these from your Supabase Dashboard -> Storage -> S3 Credentials
AWS_ACCESS_KEY_ID=replace_with_supabase_s3_access_key
AWS_SECRET_ACCESS_KEY=replace_with_supabase_s3_secret_key
AWS_STORAGE_BUCKET_NAME=replace_with_bucket_name
AWS_S3_ENDPOINT_URL=https://[project-ref].supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=ap-south-1

# Supabase SDK (Required for image uploads — menu items, logos, QR codes)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=replace_with_supabase_service_role_key

# Error reporting
SERVER_EMAIL=noreply@example.com
ADMINS=Ops,ops@example.com





